[zh-cn]
name = "网络定位"
auth = "qishiyi"
descript = "发现当前局域网设备，读取网卡、IP、MAC 状态，并按 MAC 后四位快速定位设备。"
release_note = "1.2.1：采用绿色主题，界面拆分为“我的设备”和“设备总表”两个分区。设备总表支持勾选和行内复制，状态改为中文，筛选栏显示当前网段，并修复提示文字、刷新加载和应用图标。"
important = "扫描只读取本机路由和邻居表，不会更改 NAS 或其他设备的网络配置。"

[zh-hk]
name = "網絡定位"
auth = "qishiyi"
descript = "搜尋目前區域網絡裝置，讀取網卡、IP、MAC 狀態，並按 MAC 尾四位定位裝置。"
release_note = "1.2.1：採用綠色主題，介面拆分為「我的設備」和「裝置總表」兩個分區。裝置總表支援勾選和行內複製，狀態改為中文，篩選欄顯示目前網段，並修正提示文字、重新整理載入和應用圖示。"
important = "掃描只讀取本機路由和鄰居表，不會更改 NAS 或其他裝置的網絡設定。"

[en-us]
name = "Network Locator"
auth = "qishiyi"
descript = "Find devices on the current LAN and match the last four MAC characters with live interface and neighbor data."
release_note = "1.2.1: green theme, separate My Devices and Device Table sections, a simplified device table with row selection and inline copy, Chinese status labels, network chips in the filter bar, horizontal tooltips, a refresh loading state, and a new app icon."
important = "The app only reads local routing and neighbor data. It never changes NAS or device network settings."

[fr-fr]
name = "Localisateur réseau"
auth = "qishiyi"
descript = "Trouvez les appareils du reseau local et filtrez-les par les quatre derniers caracteres de leur adresse MAC."
release_note = "1.2.1 : thème vert, sections Mes appareils et Table des appareils séparées, tableau simplifié avec sélection et copie en ligne, statuts en chinois, puces de réseau, infobulles horizontales, état de chargement et nouvelle icône."
important = "L'application lit uniquement le routage local et la table voisine, sans modifier la configuration reseau."

[de-de]
name = "Netzwerk-Locator"
auth = "qishiyi"
descript = "Findet Geraete im aktuellen LAN und filtert sie anhand der letzten vier MAC-Zeichen."
release_note = "1.2.1: grünes Design, getrennte Bereiche Meine Geräte und Gerätetabelle, vereinfachte Tabelle mit Auswahl und Kopieren in der Zeile, chinesische Statuslabels, Netzwerk-Chips, horizontale Tooltips, Ladezustand und neues App-Symbol."
important = "Die App liest nur lokale Routing- und Nachbardaten und aendert keine Netzwerkeinstellungen."

[it-it]
name = "Localizzatore di rete"
auth = "qishiyi"
descript = "Trova i dispositivi nella LAN corrente e filtra per gli ultimi quattro caratteri dell'indirizzo MAC."
release_note = "1.2.1: tema verde, sezioni I miei dispositivi e Tabella dispositivi separate, tabella semplificata con selezione e copia in linea, stati in cinese, chip di rete, tooltip orizzontali, stato di caricamento e nuova icona."
important = "L'app legge solo routing e tabella dei vicini e non modifica la configurazione di rete."

[es-es]
name = "Localizador de red"
auth = "qishiyi"
descript = "Encuentra dispositivos en la LAN actual y filtra por los ultimos cuatro caracteres de su direccion MAC."
release_note = "1.2.1: tema verde, secciones Mis dispositivos y Tabla de dispositivos separadas, tabla simplificada con selección y copia en línea, estados en chino, chips de red, información emergente horizontal, estado de carga y nuevo icono."
important = "La aplicacion solo lee el enrutamiento y la tabla de vecinos sin cambiar la configuracion de red."

[hu-hu]
name = "Hálózati lokalizáló"
auth = "qishiyi"
descript = "Megkeresi az aktuális LAN eszközeit, és a MAC-cím utolsó négy karaktere alapján szűri őket."
release_note = "1.2.1: zöld téma, külön Saját eszközök és Eszköztábla szakasz, egyszerűsített táblázat kijelöléssel és soron belüli másolással, kínai állapotcímkék, hálózati chipek, vízszintes tippek, betöltési állapot és új ikon."
important = "Az alkalmazás csak helyi útvonal- és szomszédadatokat olvas, hálózati beállítást nem módosít."

[ja-jp]
name = "ネットワークロケーター"
auth = "qishiyi"
descript = "現在の LAN 上のデバイスを検出し、MAC アドレスの末尾 4 文字で絞り込みます。"
release_note = "1.2.1：グリーンテーマを採用し、「マイデバイス」と「デバイス表」を2つのセクションに分離しました。デバイス表は行選択と行内コピーに対応し、状態は中国語表示、フィルターバーにネットワークチップを追加し、ツールチップ、読み込み表示、アプリアイコンを改善しました。"
important = "ローカルのルーティング情報と近隣テーブルのみを読み取り、ネットワーク設定は変更しません。"

[ko-kr]
name = "네트워크 로케이터"
auth = "qishiyi"
descript = "현재 LAN의 장치를 찾고 MAC 주소 마지막 네 문자로 빠르게 구분합니다."
release_note = "1.2.1: 녹색 테마를 적용하고 '내 장치'와 '장치 표'를 두 섹션으로 분리했습니다. 장치 표는 행 선택과 행 내 복사를 지원하며, 상태는 중국어로 표시하고, 필터 바에 네트워크 칩을 추가했으며, 툴팁과 로딩 표시, 앱 아이콘을 개선했습니다."
important = "앱은 로컬 라우팅과 이웃 테이블만 읽으며 네트워크 설정을 변경하지 않습니다."

[pl-pl]
name = "Lokalizator sieci"
auth = "qishiyi"
descript = "Znajduje urzadzenia w biezacej sieci LAN i filtruje je po czterech ostatnich znakach adresu MAC."
release_note = "1.2.1: zielony motyw, osobne sekcje Moje urządzenia i Tabela urządzeń, uproszczona tabela z zaznaczaniem i kopiowaniem w wierszu, chińskie etykiety stanu, chipy sieci, poziome podpowiedzi, stan ładowania i nowa ikona."
important = "Aplikacja tylko odczytuje lokalne trasy i tabele sasiadow, bez zmiany konfiguracji sieci."

[ru-ru]
name = "Сетевой локатор"
auth = "qishiyi"
descript = "Находит устройства в текущей локальной сети и фильтрует их по последним четырём символам MAC."
release_note = "1.2.1: зелёная тема, отдельные разделы Мои устройства и Таблица устройств, упрощённая таблица с выбором строк и копированием, китайские статусы, чипы сетей, горизонтальные подсказки, индикатор загрузки и новый значок."
important = "Приложение только читает локальную маршрутизацию и таблицу соседей, не меняя настройки сети."

[tr-tr]
name = "Ağ Konum Bulucu"
auth = "qishiyi"
descript = "Geçerli LAN cihazlarını bulur ve MAC adresinin son dört karakterine göre filtreler."
release_note = "1.2.1: yeşil tema, ayrı Cihazlarım ve Cihaz Tablosu bölümleri, satır seçimi ve satır içi kopyalama destekli sade tablo, Çince durum etiketleri, ağ çipleri, yatay ipuçları, yükleme durumu ve yeni uygulama simgesi."
important = "Uygulama yalnızca yerel yönlendirme ve komşu verilerini okur, ağ ayarlarını değiştirmez."

[pt-pt]
name = "Localizador de rede"
auth = "qishiyi"
descript = "Encontra dispositivos na LAN atual e filtra pelos quatro ultimos caracteres do endereco MAC."
release_note = "1.2.1: tema verde, secções Meus dispositivos e Tabela de dispositivos separadas, tabela simplificada com seleção e cópia na linha, estados em chinês, chips de rede, dicas horizontais, estado de carregamento e novo ícone."
important = "A aplicacao apenas le o encaminhamento local e a tabela de vizinhos sem alterar a configuracao de rede."
